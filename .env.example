# Managed database configuration for the API (root .env).
# Copy the PostgreSQL URL from Supabase Dashboard > Connect. The direct URL
# requires IPv6 or the Supabase IPv4 add-on; use Session pooler on IPv4-only
# networks. Percent-encode reserved characters in the database password.
DATABASE_URL=
API_PORT=3100
WEB_ORIGIN=http://127.0.0.1:5173
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters

# SMTP is required to deliver verification and reset emails. Keep real
# credentials only in a private env file or secret manager.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_SECURE=
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM=

# Existing NEXT_PUBLIC_SUPABASE_* and GOOGLE_* variables in private .env are
# not used by the current Vite/Nest foundation.
