{
  "name": "@keycat/api",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "tsc -p ../../packages/typing-core/tsconfig.json && tsc -p tsconfig.json && node dist/main.js",
    "build": "tsc -p ../../packages/typing-core/tsconfig.json && tsc -p tsconfig.json",
    "typecheck": "tsc -p ../../packages/typing-core/tsconfig.json && tsc -p tsconfig.json --noEmit",
    "test": "tsc -p ../../packages/typing-core/tsconfig.json && tsc -p tsconfig.json && node --test --test-concurrency=1 tests/*.test.cjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "seed:local": "tsc -p ../../packages/typing-core/tsconfig.json && tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.2",
    "class-transformer": "^0.5.0",
    "class-validator": "^0.14.0",
    "cookie-parser": "1.4.7",
    "dotenv": "^17.0.0",
    "jsonwebtoken": "9.0.3",
    "nodemailer": "10.5.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/jsonwebtoken": "9.0.10",
    "@types/nodemailer": "8.0.2",
    "prisma": "7.10.1",
    "tsx": "^4.0.0"
  }
}
