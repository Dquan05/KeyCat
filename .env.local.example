# Local Docker PostgreSQL; copy to .env.local and replace the sample password
# in both POSTGRES_PASSWORD and DATABASE_URL. The copied .env.local stays local.
POSTGRES_USER=keycat
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=keycat
POSTGRES_PORT=5432
DATABASE_URL=postgresql://keycat:replace-with-a-local-password@localhost:5432/keycat
API_PORT=3100
WEB_ORIGIN=http://127.0.0.1:5173
AUTH_JWT_SECRET=replace-with-at-least-32-random-characters

# Add SMTP_* and EMAIL_FROM privately to test mail delivery locally.
